# ═══════════════════════════════════════════════════════════
# UUSD Network — REQUIRED environment variables
# Deploy করার আগে অবশ্যই সেট করতে হবে। Optional নয়।
# ═══════════════════════════════════════════════════════════

# --- MySQL (Railway: Reference from MySQL service) ---
# MYSQLHOST=
# MYSQLPORT=3306
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# MYSQL_URL=

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=uusd_network
DB_POOL_SIZE=25

PORT=3001
NODE_ENV=production

# --- REQUIRED secrets (strong random strings, min 32 chars recommended) ---
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
WALLET_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_LONG_RANDOM_STRING

# --- REQUIRED in production ---
BOT_TOKEN=123456:ABC-DEF_your_telegram_bot_token
CORS_ORIGIN=https://your-frontend.vercel.app

# --- Admin (required to seed admin user on boot) ---
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

# --- Optional ---
BSC_RPC_URL=https://bsc-dataseed.binance.org/
UUSD_TOKEN_CONTRACT=

# Local/dev only — NEVER set in production:
# ALLOW_INSECURE_DEV_AUTH=true
# ALLOW_WEAK_SECRETS=true
