# ===== Railway MySQL (auto when plugin linked) =====
# MYSQLHOST=
# MYSQLPORT=3306
# MYSQLUSER=
# MYSQLPASSWORD=
# MYSQLDATABASE=
# MYSQL_URL=

# Local MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=uusd_network
DB_POOL_SIZE=25

PORT=3001
NODE_ENV=development

# MUST change in production
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Telegram Bot token — enables real initData HMAC verification
BOT_TOKEN=
# TELEGRAM_BOT_TOKEN=   # alias

# Frontend origin for CORS (Railway frontend URL)
CORS_ORIGIN=http://localhost:3000
